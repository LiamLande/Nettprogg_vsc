{
  "name": "liveshare-lite",
  "displayName": "LiveShare Lite",
  "description": "Proof-of-concept VS Code extension for CRDT-based collaborative text editing. CRDT and network servers implemented in Rust.",
  "version": "0.2.0",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:liveshareLite.startServer",
    "onCommand:liveshareLite.startSignalingServer",
    "onCommand:liveshareLite.startSession",
    "onCommand:liveshareLite.joinSession",
    "onCommand:liveshareLite.leaveSession",
    "onCommand:liveshareLite.forceShutdown",
    "onCommand:liveshareLite.showDebugState",
    "onCommand:liveshareLite.runLocalDemo"
  ],
  "main": "./dist/extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "liveshareLite.startServer",
        "title": "LiveShare Lite: Start Server"
      },
      {
        "command": "liveshareLite.startSignalingServer",
        "title": "LiveShare Lite: Start Signaling Server"
      },
      {
        "command": "liveshareLite.startSession",
        "title": "LiveShare Lite: Start Session"
      },
      {
        "command": "liveshareLite.joinSession",
        "title": "LiveShare Lite: Join Session"
      },
      {
        "command": "liveshareLite.leaveSession",
        "title": "LiveShare Lite: Leave Session"
      },
      {
        "command": "liveshareLite.forceShutdown",
        "title": "LiveShare Lite: Force Shutdown"
      },
      {
        "command": "liveshareLite.showDebugState",
        "title": "LiveShare Lite: Show Debug State"
      },
      {
        "command": "liveshareLite.runLocalDemo",
        "title": "LiveShare Lite: Run Local CRDT Demo"
      }
    ],
    "configuration": {
      "title": "LiveShare Lite",
      "properties": {
        "liveshareLite.serverUrl": {
          "type": "string",
          "default": "ws://127.0.0.1:7071",
          "description": "Default WebSocket relay server URL."
        },
        "liveshareLite.serverPort": {
          "type": "number",
          "default": 7071,
          "description": "Default local relay server port."
        },
        "liveshareLite.transportMode": {
          "type": "string",
          "enum": [
            "relay",
            "p2p"
          ],
          "default": "relay",
          "description": "Transport mode. Relay uses the WebSocket operation relay; p2p uses WebRTC DataChannels with a signaling server."
        },
        "liveshareLite.signalingUrl": {
          "type": "string",
          "default": "ws://127.0.0.1:7072",
          "description": "Default WebSocket signaling server URL for P2P mode."
        },
        "liveshareLite.signalingPort": {
          "type": "number",
          "default": 7072,
          "description": "Default local signaling server port."
        },
        "liveshareLite.iceServers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "stun:stun.l.google.com:19302"
          ],
          "description": "ICE servers used by WebRTC P2P mode."
        },
        "liveshareLite.reconnectDelayMs": {
          "type": "number",
          "default": 1500,
          "description": "Delay before reconnecting after a dropped relay connection."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:crdt": "cargo test --manifest-path crates/Cargo.toml -p crdt-core",
    "test:server": "cargo test --manifest-path crates/Cargo.toml -p relay-server -p signaling-server",
    "start:server": "npm run rust:start:relay",
    "start:signaling": "npm run rust:start:signaling",
    "rust:build": "cargo build --manifest-path crates/Cargo.toml",
    "rust:release": "cargo build --release --manifest-path crates/Cargo.toml",
    "rust:test": "cargo test --manifest-path crates/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path crates/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path crates/Cargo.toml --all-targets -- -D warnings",
    "rust:start:relay": "cargo run --release --manifest-path crates/Cargo.toml --bin relay-server",
    "rust:start:signaling": "cargo run --release --manifest-path crates/Cargo.toml --bin signaling-server",
    "build:wasm": "wasm-pack build crates/crdt-wasm --target nodejs --out-dir ../../src/wasm/crdt",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "node-datachannel": "^0.32.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.100.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.3",
    "vitest": "^4.1.6"
  }
}
